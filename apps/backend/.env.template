# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL) ---
# Local (docker compose):
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
# Set to true for hosted databases that need SSL (Supabase, Railway, Neon...)
DATABASE_SSL=false

# --- Redis (cache, events, workflows, locks) ---
# Leave empty to use in-memory versions (local dev only).
REDIS_URL=redis://localhost:6379

# --- CORS: which websites may call the API ---
# Nuxt store
STORE_CORS=http://localhost:3000
# Nuxt admin
ADMIN_CORS=http://localhost:3001
AUTH_CORS=http://localhost:3000,http://localhost:3001

# --- Secrets: use long random values in production ---
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Process mode: shared (dev), server or worker (production) ---
MEDUSA_WORKER_MODE=shared

# --- Payments (each provider is turned on only when its key is set) ---
# Paystack: dashboard > Settings > API Keys & Webhooks.
# Webhook URL to set there: <backend-url>/hooks/payment/paystack_paystack
PAYSTACK_SECRET_KEY=
# Your store's page that finishes checkout after payment
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/paystack

# Flutterwave: dashboard > Settings > API Keys, and Settings > Webhooks.
# Webhook URL to set there: <backend-url>/hooks/payment/flutterwave_flutterwave
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" you choose in Flutterwave's webhook settings
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/checkout/flutterwave
STORE_NAME=My Store
