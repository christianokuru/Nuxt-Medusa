{
  "name": "@nuxt-medusa/backend",
  "version": "0.0.1",
  "description": "Medusa backend for Nuxt-Medusa (React admin disabled).",
  "license": "MIT",
  "keywords": [
    "medusa",
    "postgres",
    "redis",
    "ecommerce",
    "headless"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed": "medusa exec ./src/scripts/seed-demo-products.ts",
    "db:migrate": "medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/caching": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/draft-order": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.7",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@10.9.9"
}
