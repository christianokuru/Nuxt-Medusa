{
  "name": "nuxt-medusa",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "backend:dev": "turbo dev --filter=@nuxt-medusa/backend",
    "backend:migrate": "npm run db:migrate --workspace=@nuxt-medusa/backend",
    "backend:seed": "npm run seed --workspace=@nuxt-medusa/backend",
    "backend:user": "npm exec --workspace=@nuxt-medusa/backend -- medusa user"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "ajv": "^8.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
